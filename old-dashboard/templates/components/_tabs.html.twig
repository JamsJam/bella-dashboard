{# 
    {% include 'components/tabs.html.twig' with {
        theme: 'dark',
        tabs: [
            { label: 'Home', href: path('app_home'), isActive: true },
            { label: 'Users', href: path('app_user_index') },
            { label: 'Settings', href: path('app_settings'), attr: {'data-test': 'settings'} }
        ]
    } %}
#}

<nav class="tabs tabs--{{theme}}" role="tablist">
    {% for tab in tabs %}
        
        <a 
            role="tab"
            aria-selected="{{ tab.isActive ? 'true' : 'false' }}"
            class="tab tab--{{theme}} {{ tab.isActive ? "active" : "" }} " 
            href="{{ path( tab.href ) ?? "#"  }}" 
            
            {% if tab.attr is defined %}
                {% for key, attr in tab.attr %}
                    {{ key }}="{{ attr }}"
                {% endfor %}        
            {% endif %}        
        >
        
        {{tab.label ?? "tab"}}</a>
    {% endfor %}

</nav>