{% block edit_color_form %}

	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				<a class="button__action" data-turbo-frame="admin-main" href="{{path('app_avatar_color_new_cancel',{type: type})}}" data-turbo-action="replace">{{"annuler"|capitalize}}</a>
			</div>
		</template>
	</turbo-stream>

	<turbo-stream action="append" targets="#color__grid">
		<template>
			<div class="modal" id="color-form-modal" {{stimulus_controller("color_preview")}}>
				{{ form_start(form,{'action': path('app_avatar_color_edit',{id:color.id, type: type})})}}
				<h2>
					{{color.name}}
				</h2>


				<div class="color__field">
					<div
						class="color__visualizer" {{stimulus_target("color_preview","visualizer")}} style="{{ color.hexa is same as null ? "" : "background-color:#" ~ color.hexa}}">{# color visualizer #}
					</div>
					<div
						class="color__modifier">
						{# color modifier #}
						<div>
							{{form_row(form.hexa)}}
							{# <label for="color_form_hexa" class="required">Hexa</label>
								<input type="text" id="color_form_hexa" name="color_form[hexa]" {{stimulus_target("color_preview","text_input") | stimulus_action("color_preview","colorChangeByInputColor","input",)}}> #}
						</div>
						<div>
							<button type="button" class="color__button">
								Choisir une couleurs
								<input class="color__input" type="color" id="color_form_hexa-color" name="color_form[hexa-color]" value="{{color.hexa is same as null ? '#000000' : '#' ~ color.hexa}}" {{stimulus_target("color_preview","color_input") | stimulus_action("color_preview","colorChangeByColorPicker","input") | stimulus_action("color_preview","colorChangeByInputColor","input")}}>
							</button>
						</div>
					</div>
				</div>

				<div class="button__container">
					<button class="button__action" type="submit">Modifier</button>

				</div>
				{{ form_end(form)}}
			</div>
		</template>
	</turbo-stream>


{% endblock %}

{% block success_edit_color %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				{% if type is not same as null %}
					<a {# target="color__grid" #} href="{{path('app_avatar_color_new',{type: type})}}" data-turbo-frame="_top" class="button__action">
						{{"Ajouter une couleurs"|capitalize}}
					</a>
				{% endif %}
			</div>
		</template>

	</turbo-stream>


	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>

	<turbo-stream action="update" targets="#row-{{color.id}}">
		<template>

                                
                                <span class="row__visual" style="{{ color.hexa is same as null ? "" : "background-color:#" ~ color.hexa}}">
                                </span>
                                
                                <p>{{color.name|capitalize}}</p>
                                
                                {% if color.hexa is same as null %}
                                    <p class="row__color">non assigned</p>
                                {% else %}
                                    <p class="row__color">{{'#' ~ color.hexa}}</p>
                                {% endif %}
                                
                                <div class="row__action">
                                    <a class="action__edit" href="{{path('app_avatar_color_edit',{id:color.id,type: type})}}" title="Modifier la couleur">
                                        {{ ux_icon('mdi:edit-outline') }}
                                    </a>
                                    <form action="{{path('app_avatar_color_delete',{id:color.id, type: type})}}" method="post" >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-color') }}">
                                        <button 
                                            type="submit" 
                                            class="action__delete" 
                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette couleur ? Cette action entraînera la suppression de toutes les pièces d\'avatar portant cette couleur.');"
                                            >
                                            {{ ux_icon('weui:delete-outlined') }}
                                        </button>
                                    </form>
                                </div>

		</template>
	</turbo-stream>
{% endblock %}

{% block delete_new_color_form %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				{% if type is not same as null %}
					<a {# target="color__grid" #} href="{{path('app_avatar_color_new',{type: type})}}" data-turbo-frame="_top" class="button__action">
						{{"Ajouter une couleurs"|capitalize}}
					</a>
				{% endif %}
			</div>
		</template>

	</turbo-stream>
	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>
{% endblock %}
