{% extends 'base.html.twig' %}


{% block title %}Vêtements {{parent()}}{% endblock %}

{% block body %}

    <article class="clothes">
            {% for pageblock in pageView.blocks %}
                <pre>
                    {{ dump(pageblock.getTemplate()) }}
                </pre>
                <pre>
                    {{ dump(pageblock.getData()) }}
                </pre>
                {% include pageblock.getTemplate() with pageblock.getData() %}
            {% endfor %}

    </article>
{% endblock %}
