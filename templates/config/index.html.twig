{% extends 'base.html.twig' %}

{% block title %}Configuration{% endblock %}

{% block body %}
    <article class="config-page" aria-labelledby="config-title">
        <header class="admin-page__header">
            <div>
                <h1 id="config-title" class="title">Configuration</h1>
                <p class="admin-page__subtitle">Parametres generaux du site et du tunnel de commande.</p>
            </div>
        </header>

        <section class="config-page__grid">
            <form method="post" action="{{ path('app_config_general_update') }}" class="config-card">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('config_general_update') }}">

                <header class="config-card__header">
                    <h2>General</h2>
                </header>

                <label class="config-field">
                    <span>Titre du site</span>
                    <input type="text" name="site_title" value="{{ general.siteTitle }}" required>
                </label>

                <label class="config-field">
                    <span>Description</span>
                    <textarea name="site_description" rows="4">{{ general.siteDescription }}</textarea>
                </label>

                <label class="config-field">
                    <span>Email</span>
                    <input type="email" name="email" value="{{ general.email }}" required>
                </label>

                <label class="config-field">
                    <span>Telephone</span>
                    <input type="text" name="phone" value="{{ general.phone }}">
                </label>

                <label class="config-field">
                    <span>Adresse</span>
                    <textarea name="address" rows="3">{{ general.address }}</textarea>
                </label>

                <footer class="config-card__actions">
                    <button type="submit" class="clothe-show__action">Enregistrer</button>
                </footer>
            </form>

            <form method="post" action="{{ path('app_config_order_update') }}" class="config-card">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('config_order_update') }}">

                <header class="config-card__header">
                    <h2>Commande</h2>
                </header>

                <label class="config-field">
                    <span>Devise</span>
                    <input type="text" name="currency" value="{{ order.currency }}" maxlength="3" required>
                </label>

                <label class="config-field">
                    <span>Statut par defaut</span>
                    <input type="text" name="default_status" value="{{ order.defaultStatus }}" required>
                </label>

                <label class="config-field">
                    <span>Montant minimum</span>
                    <input type="number" name="minimum_amount" value="{{ order.minimumAmount }}" min="0" step="1">
                </label>

                <label class="config-field">
                    <span>Frais de livraison</span>
                    <input type="number" name="shipping_cost" value="{{ order.shippingCost }}" min="0" step="1">
                </label>

                <label class="config-field">
                    <span>Livraison offerte a partir de</span>
                    <input type="number" name="free_shipping_from" value="{{ order.freeShippingFrom }}" min="0" step="1">
                </label>

                <label class="config-checkbox">
                    <input type="checkbox" name="allow_guest_checkout" value="1" {{ order.allowGuestCheckout ? 'checked' : '' }}>
                    <span>Autoriser les commandes sans compte client</span>
                </label>

                <footer class="config-card__actions">
                    <button type="submit" class="clothe-show__action">Enregistrer</button>
                </footer>
            </form>
        </section>
    </article>
{% endblock %}
