{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block body %}
    <article class="config-page" aria-labelledby="config-title">
        <header class="admin-page__header">
            <div>
                <h1 id="config-title" class="title">{{ title }}</h1>
                {% if subtitle %}
                    <p class="admin-page__subtitle">{{ subtitle }}</p>
                {% endif %}
            </div>
        </header>

        <section class="config-page__content">
            {{ form_start(form, { attr: stimulus_controller('config-image-upload').toArray()|merge({
                class: homepage_form|default(false) ? 'config-card config-card--homepage' : 'config-card'
            }) }) }}
                {{ form_errors(form) }}

                {% if homepage_form|default(false) %}
                    {% include 'config/_homepage_config_fields.html.twig' with { form: form } only %}
                {% elseif form.sections is defined and form.openGraphYaml is defined %}
                    {% include 'config/_page_config_fields.html.twig' with { form: form } only %}
                {% else %}
                    {% for child in form %}
                        {% if 'collection' in child.vars.block_prefixes %}
                            {% set prototypeHtml %}
                                {% include 'config/_collection_entry.html.twig' with { entry: child.vars.prototype } only %}
                            {% endset %}
                            <div
                                class="config-collection"
                                {{ stimulus_target('config-image-upload', 'collection') }}
                                data-config-collection
                                data-prototype="{{ prototypeHtml|e('html_attr') }}"
                                data-index="{{ child|length }}"
                            >
                                <div class="config-collection__header">
                                    {{ form_label(child) }}
                                    <button
                                        type="button"
                                        class="config-collection__add"
                                        {{ stimulus_action('config-image-upload', 'addCollectionItem', 'click') }}
                                    >Ajouter</button>
                                </div>

                                <div class="config-collection__items" {{ stimulus_target('config-image-upload', 'collectionItems') }}>
                                    {% for entry in child %}
                                        {% include 'config/_collection_entry.html.twig' with { entry: entry } only %}
                                    {% endfor %}
                                </div>
                            </div>
                        {% elseif 'file' in child.vars.block_prefixes and child.vars.name in ['logoFile', 'faviconFile'] %}
                            {% set imageKind = child.vars.name == 'logoFile' ? 'logo' : 'favicon' %}
                            {% set publicUrl = imageKind == 'logo'
                                ? logo_public_url|default(form.vars.data.siteLogo|default(''))
                                : favicon_public_url|default(form.vars.data.favicon|default(''))
                            %}
                            {% include 'config/_image_field.html.twig' with {
                                form: form,
                                image_kind: imageKind,
                                public_url: publicUrl,
                            } only %}
                        {% elseif child.vars.name not in ['logoCrop', 'faviconCrop', '_token'] %}
                            <div class="config-field">
                                {{ form_label(child) }}
                                {{ form_widget(child) }}
                                {{ form_help(child) }}
                                {{ form_errors(child) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                {% endif %}

                <footer class="config-card__actions">
                    <button type="submit" class="clothe-show__action">Enregistrer</button>
                </footer>
            {{ form_end(form) }}
        </section>
    </article>
{% endblock %}
