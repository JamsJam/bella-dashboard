<li{{ attributes }} class="{{routeKey is same as(key) ? activClass : class}} ">
    <!-- component HTML -->


    <a 
        href="{{path(route)}}"
        aria-label="{{ariaLabel}}"
        {# title="{{item}}" #}
        data-turbo-frame="admin-main"
        target="admin-main"
        {# data-turbo-preload="true" #}
        data-turbo-action="advance"
        {{stimulus_target('menu_reload', 'navlink')}}
    >
        {{label}}
    </a>



</li>
