{% block index %}
    {#? ====== navigation  #}
    <turbo-stream action="replace" target="clothes__navigation">
        <template>
            <div class="clothes__navigation" id="clothes__navigation">

                <a 
                    class="button__action" 
                    href="{{path('app_avatar_color_index')}}"
                    data-turbo-frame="admin-main"
                    {# data-turbo-preload="true" #}
                    data-turbo-action="replace"
                >
                    Categorie
                </a>
                <a 
                    class="button__action" 
                    href="{{path('app_avatar_shape_index')}}"
                    data-turbo-frame="admin-main"
                    {# data-turbo-preload="true" #}
                    data-turbo-action="replace"
                >
                    Collection
                </a>
                <a 
                    class="button__action return" 
                    {# href="{{ path(metaData.breadcrumb[metaData.breadcrumb|length - 2].route) }}"  #}
                    href="{{ path(routePath) }}" 
                    data-turbo-frame="admin-main"
                    data-turbo-action="replace"
                >
                    Retour
                </a> 
            </div>
        </template>
    </turbo-stream>

    {#? ====== action  #}
    <turbo-stream action="replace" target="clothes__action" >
        <template>
            <div class="clothes__action" id="clothes__action">

                <a 
                    class="button__action" 
                    href="{{ path('app_avatar_new') }}" 
                    {# data-turbo-frame="admin-main" #}
                    data-turbo-action="replace"
                >
                    Ajouter des Vetements
                </a> 
            </div>
        </template>
    </turbo-stream>

    {#? ====== content  #}
    <turbo-stream action="replace" target="clothes__container">
        <template>
            <div id="clothes__container" class="clothes__container">

                <div class="grid" {{stimulus_controller('grid_filter',{
                        deleteToken : csrf_token('delete-part-avatar-token'), 
                        deleteUrl : path('app_avatar_delete')
                    })}}>

                    {#? ==== filters #}
                    <form class='grid__filter' >

                        {% for name, value in filters %}
                            {%  if value is not null %}
                                <div class="filter" {{stimulus_controller('collapsebox')}}>
                                    <button type="button" class="filter__title" {{stimulus_target('collapsebox','toggler')}}>{{name}}</button>
                                
                                    <div class="filter__items filter__items--close" {{stimulus_target('collapsebox','collapsebox')}}>


                                        {% for item in value %}
                                            
                                            <div class="filter__item">
                                                <input type="checkbox" name="{{name}}"  id="{{name ~ '-' ~ loop.index}}" value="{{item.id}}" {{stimulus_target('grid_filter','filterOption')}}>
                                                <label for="{{name}}{{loop.index}}">{{item.name}}</label>
                                            </div>
                                            
                                            {% else %}
                                                aucun filtre disponible
                                        {% endfor %}

                                    </div>
                                </div>
                            {% endif %}
                        {% endfor %}

                    </form>

                    <div class={{  clothes|length is same as 0 ? 'grid__result--empty' : 'grid__result' }}>
                        {% for item in clothes %}
                                <div class="card card--unselected" {{stimulus_target('grid_filter','card')}}>
                                    <input type="checkbox" name="{{type}}" id="{{type ~'-'~ item.id}}" value={{item.id}} class='card__selectInput'>
                                    <div class="card__image">
                                            
                                        <img src="{{item.image}}" alt="">

                                    </div>
                                    <p>{{item.name}}</p>
                                </div>
                        {% else %}

                        
                            <p>Aucun element disponible pour le moment. Ajouter des elements</p>

                        {% endfor %}
                    </div>
                        
                </div>
            </div>
        </template>


    </turbo-stream>
{% endblock %}