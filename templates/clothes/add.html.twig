{% extends 'base.html.twig' %}

{% block title %}Ajouter un vêtement{% endblock %}

{% block body %}
    <article class="collection-add clothe-create" aria-labelledby="clothe-add-title">
        <header class="admin-page__header clothe-create__header">
            <div>
                <p class="clothe-create__eyebrow">Catalogue</p>
                <h1 id="clothe-add-title" class="title">Ajouter un vêtement</h1>
                <p class="admin-page__subtitle">Crée le vêtement, puis décline-le par couleur et par taille.</p>
            </div>
        </header>

        {% include 'ui/components/tabs/_tabs.html.twig' with { tabs: tabs } only %}

        {{ form_start(form, {attr: {class: 'collection-form clothe-create__form', enctype: 'multipart/form-data', 'data-controller': 'clothe-form'}}) }}
            {{ form_errors(form) }}
            <section class="collection-form__section clothe-create__section" aria-labelledby="clothe-information-title">
                <div class="clothe-create__section-heading">
                    <span class="clothe-create__step" aria-hidden="true">01</span>
                    <div>
                        <h2 id="clothe-information-title">Informations générales</h2>
                        <p>Ces informations seront partagées par toutes les variantes.</p>
                    </div>
                </div>

                <div class="collection-form__grid clothe-create__main-fields">
                    {{ form_row(form.name, {
                        row_attr: {class: 'clothe-create__field'},
                        attr: {placeholder: 'Ex. Robe Éclipse'}
                    }) }}
                    {{ form_row(form.price, {
                        row_attr: {class: 'clothe-create__field'},
                        attr: {min: 1, inputmode: 'numeric'}
                    }) }}
                    {{ form_row(form.collection, {
                        row_attr: {class: 'clothe-create__field'}
                    }) }}
                </div>
            </section>

            <section class="collection-form__section clothe-create__section" aria-labelledby="clothe-variants-title">
                <div class="collection-form__section-header">
                    <div class="clothe-create__section-heading">
                        <span class="clothe-create__step" aria-hidden="true">02</span>
                        <div>
                            <h2 id="clothe-variants-title">Variantes</h2>
                            <p>Ajoute une carte par couleur, puis sélectionne les tailles et les images.</p>
                        </div>
                    </div>
                    <button type="button" class="clothe-create__add" data-action="clothe-form#add">
                        <span aria-hidden="true">+</span>
                        Ajouter une couleur
                    </button>
                </div>
                <div
                    class="clothe-create__variants"
                    data-clothe-form-target="collection"
                    data-prototype="{{ form_widget(form.variants.vars.prototype, {attr: {class: 'clothe-create__variant-fields'}})|e('html_attr') }}"
                    data-index="{{ form.variants|length }}"
                >
                    {% for variant in form.variants %}
                        <fieldset class="collection-form__variant">
                            <legend>Variante {{ loop.index }}</legend>
                            {{ form_widget(variant, {attr: {class: 'clothe-create__variant-fields'}}) }}
                            <button type="button" class="clothe-create__remove" data-action="clothe-form#remove">
                                Supprimer cette variante
                            </button>
                        </fieldset>
                    {% endfor %}
                </div>
            </section>

            <footer class="collection-form__actions">
                <p class="clothe-create__submit-help">Le vêtement sera créé en brouillon avant vérification.</p>
                <button type="submit" class="clothe-show__action clothe-create__submit">Créer le vêtement</button>
            </footer>
        {{ form_end(form) }}
    </article>
{% endblock %}
