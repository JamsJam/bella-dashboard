<div class="modal-backdrop" {{ stimulus_controller('collection-form') }}>
    <dialog class="modal" open aria-labelledby="clothe-variant-edit-modal-title">
        <form method="post" action="{{ action }}" data-turbo="false">
            <header class="modal__header">
                <h2 id="clothe-variant-edit-modal-title">
                    {{ isGroup|default(false) ? 'Modifier les informations globales' : 'Modifier la taille' }}
                </h2>
                <button type="button" class="modal__close" onclick="this.closest('.modal-backdrop').remove()" aria-label="Fermer">
                    &times;
                </button>
            </header>

            <div class="modal__body">
                <input type="hidden" name="_csrf_token" value="{{ csrfToken }}">

                {% if isGroup|default(false) %}
                    <div class="collection-form__grid">
                        <label class="collection-form__field">
                            <span>Couleur</span>
                            <select name="color" data-action="change->collection-form#toggleNewColorField" required>
                                <option value="">Selectionner une couleur</option>
                                {% for color in colors %}
                                    <option value="{{ color.id }}" {% if color.id == variant.color.id|default(null) %}selected{% endif %}>
                                        {{ color.name }}
                                    </option>
                                {% endfor %}
                                <option value="__new__">Ajouter une couleur</option>
                            </select>
                        </label>

                        <label class="collection-form__field">
                            <span>Prix</span>
                            <input type="number" name="price" min="1" step="1" value="{{ variant.clothes.price }}" required>
                        </label>
                    </div>

                    <div class="collection-form__grid">
                        <label class="collection-form__field" data-collection-form-new-color-name hidden>
                            <span>Nouvelle couleur</span>
                            <input type="text" name="newColorName" maxlength="50">
                        </label>

                        <label class="collection-form__field" data-collection-form-new-color-hex hidden>
                            <span>Code couleur</span>
                            <input type="color" name="newColorHex" value="#000000">
                        </label>
                    </div>

                    <label class="collection-form__field">
                        <span>Description</span>
                        <textarea name="description" rows="5">{{ variant.description }}</textarea>
                    </label>

                    <label class="collection-form__field">
                        <span>Description SEO</span>
                        <textarea name="metadescription" rows="3" maxlength="200">{{ variant.metadescription }}</textarea>
                    </label>
                {% else %}
                    <div class="collection-form__grid">
                        <label class="collection-form__field">
                            <span>Taille</span>
                            <select name="size" required>
                                <option value="">Selectionner une taille</option>
                                {% for size in availableSizes %}
                                    <option value="{{ size }}" {% if size == variant.size.name|default(null) %}selected{% endif %}>
                                        {{ size }}
                                    </option>
                                {% endfor %}
                            </select>
                        </label>

                        <label class="collection-form__field">
                            <span>Stock</span>
                            <input type="number" name="stock" min="0" step="1" value="{{ variant.stock }}" required>
                        </label>
                    </div>

                    <label class="collection-form__field">
                        <span>SKU</span>
                        <input type="text" value="{{ variant.sku }}" readonly>
                    </label>
                {% endif %}
            </div>

            <footer class="modal__actions">
                <button type="button" class="clothe-show__button" onclick="this.closest('.modal-backdrop').remove()">
                    Annuler
                </button>
                <button type="submit" class="clothe-show__button clothe-show__button--primary">
                    Enregistrer
                </button>
            </footer>
        </form>
    </dialog>
</div>
