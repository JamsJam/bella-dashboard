{% block new %}
	{% set strategy = 'html_attr' %}
	{% set form_clothe_prototype %}
		<div class="formpart-clothe__container">


			{{form_row(form.clothes.vars.prototype.name)}}
			{{form_row(form.clothes.vars.prototype.color)}}
			{{form_row(form.clothes.vars.prototype.stock)}}
			{{form_row(form.clothes.vars.prototype.price)}}
			{{form_row(form.clothes.vars.prototype.size ,{
				attr:{
					'data-tag-collection-target':'trueInput',
					'data-tag-prototype':include("partials/form/tag_collection/_tag.html.twig")|trim(),
					'data-false-row-prototype':include("partials/form/tag_collection/_false_row.html.twig")|trim(),
					'style': 'height: 0;width: 0;opacity: 0;',
					}
				})}}
			{{form_row(form.clothes.vars.prototype.description)}}
			{{form_row(form.clothes.vars.prototype.metadescription)}}

			{#? image multiple-container-delete-select  #}
			<div 
				class="dropzoneMultilePreview" 
				{{stimulus_controller("dropzone_preview")}} 
				>
				{{form_label(form.clothes.vars.prototype.images,)}}
				<div class='dropzone__container'  {{stimulus_target("dropzone_preview","fileInputContainer")}}>
					{{form_widget(form.clothes.vars.prototype.images,)}}
				</div>
				<div 
					class='preview__container'
					data-preview-row-prototype="{{ include("partials/form/dropzone/_preview_row.html.twig")|trim() }}"
					{{stimulus_target("dropzone_preview","previewContainer")}}
					>

				</div>
			</div>
		</div>
	{% endset %}

    <turbo-stream action="replace" target="clothes__action">
        <template>

            <div class="clothes__action" id="clothes__action" >
                <a 
                    class="button__action" 
                    href="{{ path('app_clothes_collections') }}" 
                    data-turbo-frame="admin-main"
                    data-turbo-action="replace"
                >Annuler</a> 
            </div>
        </template>
    </turbo-stream>
	
    <turbo-stream action="append" target="clothes__container">
        <template>
            <div class="modal" id="clothe-modal">
				{# {{ form_start(form)}} #}
				{{ form_start(form, {'action': path('app_clothes_collections_new')}) }}

				<h2>Ajouter une collection</h2>
				
				{{form_row(form.name)}}
				{{form_row(form.category)}}

				<div class="dropzoneWithPreview" {{stimulus_controller("dropzone-solo-preview")}}>
					<div class="dropzone__container" {{stimulus_target("dropzone-solo-preview", 'dropzoneContainer')}}>
						{{form_widget(form.image,{attr:stimulus_target("dropzone-solo-preview", 'dropzoneInput').toArray()})}}
						<p class="dropzone__placeholder" {{stimulus_target("dropzone-solo-preview", 'dropzonePlaceholder')}}>Déposer vos fichier ici ou Parcourir</p>
					</div>
				</div>


				{# <div class="form_collection">
					<h3>Guide des tailles</h3>
					<div {{ stimulus_controller('form-collection') }} 
						data-form-collection-index-value="{{ form.sizeGuide|length > 0 ? form.sizeGuide|last.vars.name + 1 : 0 }}" 
						data-form-collection-prototype-value="{{ form_widget(form.sizeGuide.vars.prototype)|e('html_attr') }}" 
						class="form_collection__container"
						>


						<ul {{ stimulus_target('form-collection', 'collectionContainer') }} class="form_collection__list"></ul>
						
						<button class="button__action" type="button" {{ stimulus_action('form-collection', 'addCollectionElement') }}>Ajouter une entrée</button>

					</div>
				</div> #}

				<div class="form_collection">
					<h3>Vetements</h3>
					<div {{ stimulus_controller('form-collection') }} 
						data-form-collection-index-value="{{ form.clothes|length > 0 ? form.clothes|last.vars.name + 1 : 0 }}" 
						data-form-collection-prototype-value="{{ form_clothe_prototype|e('html_attr') }}" 
						class="form_collection__container"
					>

						<ul {{ stimulus_target('form-collection', 'collectionContainer') }} class="form_collection__list"></ul>

						<button class="button__action" type="button" {{ stimulus_action('form-collection', 'addCollectionElement') }}>Ajouter un vetement</button>

					</div>
				</div>


				<div class="button__container">
					<button class="button__action" type="submit">Envoyer</button>

				</div>


				{{ form_end(form)}}
			</div>
        </template>
    </turbo-stream>
{% endblock %}

