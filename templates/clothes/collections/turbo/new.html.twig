{% block new %}
    <turbo-stream action="replace" target="clothes__action">
        <template>

            <div class="clothes__action" id="clothes__action" >
                <a 
                    class="button__action" 
                    href="{{ path('app_clothes_category_cancel_new') }}" 
                    data-turbo-frame="admin-main"
                    data-turbo-action="replace"
                >Annuler</a> 
            </div>
        </template>
    </turbo-stream>
	
    <turbo-stream action="append" target="clothes__container">
        <template>
            <div class="modal" id="clothe-modal">
				{# {{ form_start(form)}} #}
				{{ form_start(form, {'action': path('app_clothes_category_new')}) }}
				<h2>Ajouter une categorie</h2>
				{{form_row(form.name)}}




				<div class="dropzoneWithPreview" {{stimulus_controller("dropzone-solo-preview")}}>
						{# dropZone #}
						<div class="dropzone__container" {{stimulus_target("dropzone-solo-preview", 'dropzoneContainer')}}>
							{{form_widget(form.image,{attr:stimulus_target("dropzone-solo-preview", 'dropzoneInput').toArray()})}}
							<p class="dropzone__placeholder" {{stimulus_target("dropzone-solo-preview", 'dropzonePlaceholder')}}>Déposer vos fichier ici ou Parcourir</p>
						</div>

				</div>

				{{form_row(form.metaDescription)}}

				<div class="form_collection">
					<h3>Créer des collections</h3>


					<div {{ stimulus_controller('form-collection') }} 
						data-form-collection-index-value="{{ form.collections|length > 0 ? form.collections|last.vars.name + 1 : 0 }}" 
						data-form-collection-prototype-value="{{ form_widget(form.collections.vars.prototype)|e('html_attr') }}" 
						class="form_collection__container"
						>

						<button class="button__action" type="button" {{ stimulus_action('form-collection', 'addCollectionElement') }}>Ajouter une collection</button>

						<ul {{ stimulus_target('form-collection', 'collectionContainer') }} class="form_collection__list"></ul>

					</div>
				</div>


				<div class="button__container">
					<button class="button__action" type="submit">Envoyer</button>

				</div>
				{{ form_end(form)}}
			</div>
        </template>
    </turbo-stream>
{% endblock %}

{% block cancel_new %}
    <turbo-stream action="replace" target="clothes__action" >
        <template>

            <div class="clothes__action" id="clothes__action" >
                <a 
                    class="button__action" 
                    href="{{ path('app_clothes_category_new') }}" 
                    data-turbo-frame="admin-main"
                    data-turbo-action="replace"
                >Ajouter des catégories</a> 
            </div>
        </template>
    </turbo-stream>
	
    <turbo-stream action="remove" target="clothe-modal"></turbo-stream>
{% endblock %}

{% block new_success %}
    <turbo-stream action="replace" target="clothes__action" >
        <template>

            <div class="clothes__action" id="clothes__action" >
                <a 
                    class="button__action" 
                    href="{{ path('app_clothes_category_new') }}" 
                    data-turbo-frame="admin-main"
                    data-turbo-action="replace"
                >Ajouter des catégories</a> 
            </div>
        </template>
    </turbo-stream>
	
    <turbo-stream action="remove" target="clothe-modal"></turbo-stream>
    
	<turbo-stream action="append" target="clothes__grid">
		<template>
			<div class="clothes__row" id="row-{{categorie.id}}" >
                            
				<span><img src="{{asset(categorie.image)}}" alt="" srcset=""></span>

				<p>{{categorie.name|capitalize}}</p>
				<p>{{categorie.isOnline ? 'OneLine' : 'Offline'}}</p>
				

				
				
				<div class="clothes__action">
					<a class="action__edit" href="{{path('app_avatar_categorie_edit',{id:categorie.id})}}" title="Modifier la categorie">
						{{ ux_icon('mdi:edit-outline') }}
					</a>
					{# <form action="{{path('app_avatar_categorie_delete',{id:categorie.id})}}" method="post" >
						<input type="hidden" name="_token" value="{{ csrf_token('delete-categorie') }}">
						<button 
							type="submit" 
							class="action__delete" 
							onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette moprhologie ? Cette action entraînera la suppression de tout les body de cette mophologie cette forme.');"
							>
							{{ ux_icon('weui:delete-outlined') }}
						</button>
					</form> #}
				</div>
			</div>
		</template>
	</turbo-stream>

	
{% endblock %}