{% block show_collection %}

  
    
    <turbo-stream action="replace" target="clothes__action">
        <template>

            <div class="clothes__action" id="clothes__action" >
            {% if collection.isOnline %}
            
                <a 
                    class="button__action" 
                    href="#" 
                    {#todo path publication et dépublication  #}
                >Dépublier</a> 
            {% else %}
                <a 
                    class="button__action" 
                    href="#" 
                    {#todo path publication et dépublication  #}
                >Publier</a> 
                
            {% endif %}

                <a 
                    class="button__action" 
                    href="#" 
                    {#todo path publication et dépublication  #}
                >Catégories</a> 
            </div>
        </template>
    </turbo-stream>

	
    <turbo-stream action="append" target="clothes__container">
        <template>
            <div class="modal categoryShow" id="clothe-modal">

                <div class="category__container">
                
                    <div class="category__image">
                        <img src="{{asset(collection.image ?? "")}}" alt="">
                    </div>
                    <div class="category__info">

                        <div class="info__item">
                            <p class="title">Nom : </p>
                            <p class='value'>{{collection.name}} </p>
                        </div>

                        <div class="info__item">
                            <p class="title">En ligne : </p>
                            <label class="switch" >
								<input type="checkbox" id="toggle-{{collection.id}}" {{collection.isOnline ? "checked" : ""}} disabled</>
								<span class="slider round"></span>
							</label>
                        </div>

                        {# <div class="info__item">
                            <p class="title">méta description : </p>
                            <p class='value'>{{collection.metaDescription}}  </p>
                        </div> #}
                    </div>
                </div>

                <div class="collection__container">
                    <h3>
                        Vetements :
                    </h3>
                    <div class="collection__row">
                        <p>Nom</p>
                        <p>Status</p>
                        <p>Actions</p>
                    </div>
                    {% for clothe in clothes %}

                        <div class="collection__row">
                            {# 
                            <p>{{i}} name</p>
                            <p>status</p>
                            <div class="row__action">
                                <a class="action__show" href="{{path('app_clothes_collection_show',{id: collection.id})}}">
                                    {{ ux_icon('mdi:eye-outline') }}
                                </a>
								<a class="action__edit" href="{{path('app_clothes_collection_edit',{id:collection.id})}}" title="Modifier la categorie">
									{{ ux_icon('mdi:edit-outline') }}
								</a>
								<form action="{{path('app_clothes_collection_delete',{id:collection.id})}}" method="post" >
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category') }}">
                                    <button 
                                        type="submit" 
                                        class="action__delete" 
                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette moprhologie ? Cette action entraînera la suppression de tout les body de cette mophologie cette forme.');"
                                        >
                                        {{ ux_icon('weui:delete-outlined') }}
                                    </button>
                                </form>
							</div> #}
                            
                            <p>{{clothe.name}}</p>
                            <p>{{clothe.isOnline ? 'online' : 'offline'}} </p> 
                            {# <span></span> #}
                            <div class="row__action">
                                <a class="action__show" href="{{path('app_clothes_show',{id: clothe.id})}}">
                                    {{ ux_icon('mdi:eye-outline') }}
                                </a>
								<a class="action__edit" href="{{path('app_clothes_edit',{id:clothe.id})}}" title="Modifier la categorie">
									{{ ux_icon('mdi:edit-outline') }}
								</a>
								<form action="{{path('app_clothes_delete',{id:clothe.id})}}" method="post" >
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category') }}">
                                    <button 
                                        type="submit" 
                                        class="action__delete" 
                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette moprhologie ? Cette action entraînera la suppression de tout les body de cette mophologie cette forme.');"
                                        >
                                        {{ ux_icon('weui:delete-outlined') }}
                                    </button>
                                </form>
							</div> 

                            {#bouton voir pour acceder a app_collection_show  #}
                            
                        </div>
                        
                    {% else %}
                        <div class="collection__row empty">
                            {# <p>{{i}} name</p>
                            <p>status</p>
                            <div class="row__action">
                                <a class="action__show" href="{{path('app_clothes_collection_show',{id: collection.id})}}">
                                    {{ ux_icon('mdi:eye-outline') }}
                                </a>
								<a class="action__edit" href="{{path('app_clothes_collection_edit',{id:collection.id})}}" title="Modifier la categorie">
									{{ ux_icon('mdi:edit-outline') }}
								</a>
								<form action="{{path('app_clothes_collection_delete',{id:collection.id})}}" method="post" >
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-category') }}">
                                    <button 
                                        type="submit" 
                                        class="action__delete" 
                                        onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette moprhologie ? Cette action entraînera la suppression de tout les body de cette mophologie cette forme.');"
                                        >
                                        {{ ux_icon('weui:delete-outlined') }}
                                    </button>
                                </form>
							</div> #}
                            
                            <p>Cette catégories ne contient aucune collection</p>
                            

                            {#bouton voir pour acceder a app_collection_show  #}
                            
                        </div>
                    {% endfor %}
                        
                </div>




			</div>
        </template>
    </turbo-stream>

{% endblock %}