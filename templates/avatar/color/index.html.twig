{% extends 'base.html.twig' %}


 {% block title %}Dashboard {{parent()}}{% endblock %}

{% block body %}

    {{ include('partials/_dashboard_header.html.twig') }}

   <turbo-frame id="avatar-frame" >
        
        <section class="avatar">
        
            <header>
            
                <turbo-frame id="avatar-navigation" >
                    <div class="avatar__navigation">
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_index')}}"
                            data-turbo-frame="admin-main"
                            {# data-turbo-preload="true" #}
                            data-turbo-action="replace"
                        >Avatar</a>
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_shape_index')}}"
                            data-turbo-frame="admin-main"
                            
                            data-turbo-action="replace"
                        >Formes</a>
                        <a 
                            class="button__action button__action--return" 
                            href="{{ path(metaData.breadcrumb[metaData.breadcrumb|length - 2].route) }}" 
                            data-turbo-frame="admin-main"
                            data-turbo-action="replace"
                        >Retour</a> 
                    </div>
                </turbo-frame>
            
                <turbo-frame id="avatar-actions" >
                    <div id="avatar_actions" class="avatar__navigation">
                        {% if type is not same as null %}
                            <a 
                                {# target="color__grid" #}
                                href="{{path('app_avatar_color_new',{type: type})}}"
                                data-turbo-frame="_top" 
                                class="button__action"
                                >
                                {{"Ajouter une couleurs"|capitalize}}
                            </a>
                        {% endif %}
                    </div>
                </turbo-frame>

 
            </header>


            <turbo-frame id="avatar-container" >
                {% if type is same as null %} 
                    <div class="avatar__choice">

                        {% for key, item in colorChoice %}
                                <a 
                                    data-turbo-frame="admin-main"
                                    href="{{path('app_avatar_color_index',{type: key})}}"
                                    data-turbo-action="replace" 
                                >{{item|capitalize}}</a>

                        {% endfor %}

                        <a 
                            data-turbo-frame="admin-main"
                            href="{{path('app_avatar_color_index')}}"
                            data-turbo-action="replace" 
                        >{{'vérification'|capitalize}}</a>

                    </div>

                {% else %}


                    <div class="color__grid" id="color__grid" {{stimulus_controller("row_table")}}>

                        <div class="grid__row header">
                            <span></span>
                            <p>Nom</p>
                            <p>Couleur</p>
                            <p>Action</p>
                        </div>
                        {# {% for i in 1..10 %} #}
                        {% for colorItem in colorItems %}
                            
                            <div class="grid__row" id="row-{{colorItem.id}}" >
                                
                                <span class="row__visual" style="{{ colorItem.hexa is same as null ? "" : "background-color:#" ~ colorItem.hexa}}">
                                </span>
                                
                                <p>{{colorItem.name|capitalize}}</p>
                                
                                {% if colorItem.hexa is same as null %}
                                    <p class="row__color">non assigned</p>
                                {% else %}
                                    <p class="row__color">{{'#' ~ colorItem.hexa}}</p>
                                {% endif %}
                                
                                <div class="row__action">
                                    <a class="action__edit" href="{{path('app_avatar_color_edit',{id:colorItem.id,type: type})}}" title="Modifier la couleur">
                                        {{ ux_icon('mdi:edit-outline') }}
                                    </a>
                                    <form action="{{path('app_avatar_color_delete',{id:colorItem.id, type: type})}}" method="post" >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-color') }}">
                                        <button 
                                            type="submit" 
                                            class="action__delete" 
                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette couleur ? Cette action entraînera la suppression de toutes les pièces d\'avatar portant cette couleur.');"
                                            >
                                            {{ ux_icon('weui:delete-outlined') }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

                {% endif %}
            </turbo-frame>
        </section>
    </turbo-frame>

{% endblock %}