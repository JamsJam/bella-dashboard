{% extends 'base.html.twig' %}


 {% block title %}Dashboard {{parent()}}{% endblock %}

{% block body %}

    {{ include('partials/_dashboard_header.html.twig') }}

    <turbo-frame id="avatar-frame" >
        
        <section class="avatar">
        
            <header>
            
                <turbo-frame id="avatar-navigation" >
                    <div class="avatar__navigation">
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_index')}}"
                            data-turbo-frame="admin-main"
                            {# data-turbo-preload="true" #}
                            data-turbo-action="replace"
                        >Avatar</a>
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_color_index')}}"
                            data-turbo-frame="admin-main"
                            
                            data-turbo-action="replace"
                        >Couleur</a>
                        <a 
                            class="button__action button__action--return" 
                            href="{{ path(metaData.breadcrumb[metaData.breadcrumb|length - 2].route) }}" 
                            data-turbo-frame="admin-main"
                            data-turbo-action="replace"
                        >Retour</a> 
                    </div>
                </turbo-frame>
            
                <turbo-frame id="avatar-actions" >
                    <div id="avatar_actions" class="avatar__navigation">
                        {% if type is not same as null %}
                            <a 
                                {# target="color__grid" #}
                                href="{{path('app_avatar_shape_new',{type: type})}}"
                                data-turbo-frame="avatar-frame" 
                                class="button__action"
                                >
                                {{"Ajouter une forme de " ~ type|capitalize}}
                            </a>
                        {% endif %}
                    </div>
                </turbo-frame>

 
            </header>


            <turbo-frame id="avatar-container" >
                {% if type is same as null %} 
                    <div class="avatar__choice">

                        {% for key, item in shapeChoice %}
                                <a 
                                    data-turbo-frame="admin-main"
                                    href="{{path('app_avatar_shape_index',{type: key})}}"
                                    data-turbo-action="replace" 
                                >{{item|capitalize}}</a>

                        {% endfor %}
                        <a 
                            data-turbo-frame="admin-main"
                            href="{{path('app_avatar_morphology')}}"
                            data-turbo-action="replace" 
                        >{{'morphologie'|capitalize}}</a>
                        <a 
                            data-turbo-frame="admin-main"
                            href="{{path('app_avatar_bodysize')}}"
                            data-turbo-action="replace" 
                        >{{'taille des corps'|capitalize}}</a>
                        <a 
                            data-turbo-frame="admin-main"
                            href="{{path('app_avatar_morphotype')}}"
                            data-turbo-action="replace" 
                        >{{'morphotype'|capitalize}}</a>


                        <a 
                            data-turbo-frame="admin-main"
                            href="{{path('app_avatar_color_index')}}"
                            data-turbo-action="replace" 
                        >{{'vérification'|capitalize}}</a>

                    </div>
                    {% else %}
                        

                        <div class="color__grid" id="color__grid" {{stimulus_controller("row_table")}}>

                        <div class="grid__row header">
                            <span></span>
                            <span></span>
                            <p>Nom</p>
                            <p>Actions</p>
                        </div>

                        {% for shapeItem in shapeItems %}
                            
                            <div class="grid__row" id="row-{{shapeItem.id}}" >
                                
                                <span ></span>
                                <span ></span>
                                
                                <p>{{shapeItem.name|capitalize}}</p>
                                
                                
                                <div class="row__action">
                                    <a class="action__edit" href="{{path('app_avatar_shape_edit',{id:shapeItem.id,type: type})}}" title="Modifier la couleur">
                                        {{ ux_icon('mdi:edit-outline') }}
                                    </a>
                                    <form action="{{path('app_avatar_shape_delete',{id:shapeItem.id, type: type})}}" method="post" >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-shape') }}">
                                        <button 
                                            type="submit" 
                                            class="action__delete" 
                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette forme ? Cette action entraînera la suppression de toutes les pièces d\'avatar portant cette forme.');"
                                            >
                                            {{ ux_icon('weui:delete-outlined') }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </turbo-frame>
        </section>
    </turbo-frame>

{% endblock %}