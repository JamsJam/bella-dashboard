{% block edit_shape_form %}

	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				<a 
				class="button__action" data-turbo-frame="admin-main" href="{{path('app_avatar_shape_new_cancel',{type: type})}}" data-turbo-action="replace">{{"annuler"|capitalize}}</a>
			</div>
		</template>
	</turbo-stream>

	<turbo-stream action="append" targets="#color__grid">
		<template>
			<div class="modal" id="color-form-modal" {{stimulus_controller("color_preview")}}>
				{{ form_start(form,{'action': path('app_avatar_shape_edit',{id:shape.id, type: type})})}}

				{{form_row(form.name)}}


				<div class="button__container">
					<button class="button__action" type="submit">Modifier</button>

				</div>
				{{ form_end(form)}}
			</div>
		</template>
	</turbo-stream>


{% endblock %}

{% block success_edit_shape %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				{% if type is not same as null %}
					<a {# target="color__grid" #} href="{{path('app_avatar_shape_new',{type: type})}}" data-turbo-frame="admin-main" class="button__action">
						{{"Ajouter une couleurs"|capitalize}}
					</a>
				{% endif %}
			</div>
		</template>

	</turbo-stream>


	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>

	<turbo-stream action="update" targets="#row-{{shape.id}}">
		<template>


			<span></span>
			<span></span>

			<p>{{shape.name|capitalize}}</p>


			<div class="row__action">
				<a class="action__edit" href="{{path('app_avatar_shape_edit',{id:shape.id,type: type})}}" title="Modifier la forme">
					{{ ux_icon('mdi:edit-outline') }}
				</a>
				<form action="{{path('app_avatar_shape_delete',{id:shape.id, type: type})}}" method="post">
					<input type="hidden" name="_token" value="{{ csrf_token('delete-shape') }}">
					<button type="submit" class="action__delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette forme ? Cette action entraînera la suppression de toutes les pièces d\'avatar portant cette couleur.');">
						{{ ux_icon('weui:delete-outlined') }}
					</button>
				</form>
			</div>

		</template>
	</turbo-stream>
{% endblock %}

{% block delete_new_color_form %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				{% if type is not same as null %}
					<a {# target="color__grid" #} 
						href="{{path('app_avatar_shape_new',{type: type})}}" 
						data-turbo-frame="_top" 
						class="button__action">
						{{"Ajouter une forme de " ~ type|capitalize}}
					</a>
				{% endif %}
			</div>
		</template>

	</turbo-stream>
	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>
{% endblock %}
