{% extends 'base.html.twig' %}


 {% block title %}Dashboard {{parent()}}{% endblock %}

{% block body %}

    {{ include('partials/_dashboard_header.html.twig') }}

    <turbo-frame id="avatar-frame" >
        
        <section class="avatar">
        
            <header>
            
                <turbo-frame id="avatar-navigation" >
                    <div class="avatar__navigation">
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_index')}}"
                            data-turbo-frame="admin-main"
                            {# data-turbo-preload="true" #}
                            data-turbo-action="replace"
                        >Avatar</a>
                        <a 
                            class="button__action" 
                            href="{{path('app_avatar_color_index')}}"
                            data-turbo-frame="admin-main"
                            
                            data-turbo-action="replace"
                        >Couleur</a>
                        <a 
                            class="button__action button__action--return" 
                            href="{{ path(metaData.breadcrumb[metaData.breadcrumb|length - 2].route) }}" 
                            data-turbo-frame="admin-main"
                            data-turbo-action="replace"
                        >Retour</a> 
                    </div>
                </turbo-frame>
            
                <turbo-frame id="avatar-actions" >
                    <div id="avatar_actions" class="avatar__navigation">

                            <a 
                                {# target="color__grid" #}
                                href="{{path('app_avatar_morphotype_new')}}"
                                data-turbo-frame="avatar-frame" 
                                class="button__action"
                                >
                                {{"Ajouter une morphotype"|capitalize}}
                            </a>

                    </div>
                </turbo-frame>

 
            </header>


            <turbo-frame id="avatar-container" >


                    <div class="color__grid" id="color__grid" {{stimulus_controller("row_table")}}>

                        <div class="grid__row header">
                            <span></span>
                            <span></span>
                            <p>Nom</p>
                            <p>Actions</p>
                        </div>

                        {% for morphotype in morphotypes %}
                            
                            <div class="grid__row" id="row-{{morphotype.id}}" >
                                
                                <span ></span>
                                <span ></span>
                                
                                <p>{{morphotype.name|capitalize}}</p>
                                
                                
                                <div class="row__action">
                                    {# <a class="action__edit" href="{{path('app_avatar_morphotype_edit',{id:morphotype.id})}}" title="Modifier la morphotype">
                                        {{ ux_icon('mdi:edit-outline') }}
                                    </a> #}
                                    <form action="{{path('app_avatar_morphotype_delete',{id:morphotype.id})}}" method="post" >
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete-morphotype') }}">
                                        <button 
                                            type="submit" 
                                            class="action__delete" 
                                            onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette moprhologie ? Cette action entraînera la suppression de tout les body de cette mophologie cette forme.');"
                                            >
                                            {{ ux_icon('weui:delete-outlined') }}
                                        </button>
                                    </form>
                                </div>
                            </div>
                        {% endfor %}
                    </div>

            </turbo-frame>
        </section>
    </turbo-frame>

{% endblock %}