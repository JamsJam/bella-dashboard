{% extends 'base.html.twig' %}

{% set tabs = [
    { id: 'add', label: 'Ajouter', href: path("app_avatar_add"), isActive: false },
    { id: 'rename', label: 'Renommer', href: path("app_avatar_rename"), isActive: false },
    { id: 'deformation', label: 'Déformer une image', href: path('app_avatar_deformation'), isActive: false },
    { id: 'manage', label: 'Gérer', isActive: false, items: [
        { label: 'Gérer les couleurs', href: path('app_avatar_colors_modal') },
        { label: 'Gérer les formes', href: path('app_avatar_attributes_modal', { group: 'shapes', type: 'face' }) },
        { label: 'Gérer les tailles', href: path('app_avatar_attributes_modal', { group: 'sizes', type: 'body' }) }
    ] }
] %}

{% block title %}Gestion des avatars{% endblock %}

{% block body %}
    <article class="avatar-page" aria-labelledby="avatar-page-title">
        <header class="avatar-page__header">
            <h1 id="avatar-page-title" class="title">Avatar</h1>
            <p class="avatar-page__subtitle">
                Ajoute un nouvel avatar ou renomme un avatar deja existant.
            </p>
        </header>

        {% include 'ui/components/tabs/_tabs.html.twig' 
            with { tabs: tabs } only 
        %}
        <section>
            {% include 'ui/components/product-grid/_product-grid.html.twig' 
                with { gridData: gridData } only 
            %}
        </section>

    </article>
{% endblock %}
