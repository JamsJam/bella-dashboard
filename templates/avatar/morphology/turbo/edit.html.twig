{% block edit_morphology_form %}

	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
				<a 
				class="button__action" data-turbo-frame="admin-main" href="{{path('app_avatar_morphology_new_cancel')}}" data-turbo-action="replace">{{"annuler"|capitalize}}</a>
			</div>
		</template>
	</turbo-stream>

	<turbo-stream action="append" targets="#color__grid">
		<template>
			<div class="modal" id="color-form-modal" {{stimulus_controller("color_preview")}}>
				{{ form_start(form,{'action': path('app_avatar_morphology_edit',{id:morphologie.id})})}}

				{{form_row(form.name)}}


				<div class="button__container">
					<button class="button__action" type="submit">Modifier</button>

				</div>
				{{ form_end(form)}}
			</div>
		</template>
	</turbo-stream>


{% endblock %}

{% block success_edit_morphology %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">

					<a  href="{{path('app_avatar_morphology_new')}}" data-turbo-frame="admin-main" class="button__action">
						{{"Ajouter une couleurs"|capitalize}}
					</a>

			</div>
		</template>

	</turbo-stream>

	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>

	<turbo-stream action="update" targets="#row-{{morphologie.id}}">
		<template>

			<span></span>
			<span></span>

			<p>{{morphologie.name|capitalize}}</p>


			<div class="row__action">
				<a class="action__edit" href="{{path('app_avatar_morphology_edit',{id:morphologie.id})}}" title="Modifier la forme">
					{{ ux_icon('mdi:edit-outline') }}
				</a>
				<form action="{{path('app_avatar_morphology_delete',{id:morphologie.id})}}" method="post">
					<input type="hidden" name="_token" value="{{ csrf_token('delete-shape') }}">
					<button type="submit" class="action__delete" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette forme ? Cette action entraînera la suppression de toutes les pièces d\'avatar portant cette couleur.');">
						{{ ux_icon('weui:delete-outlined') }}
					</button>
				</form>
			</div>

		</template>
	</turbo-stream>
{% endblock %}

{% block delete_new_morphology_form %}
	<turbo-stream action="replace" targets="#avatar_actions">
		<template>
			<div id="avatar_actions" class="avatar__navigation">
					<a  
						href="{{path('app_avatar_morphology_new')}}" 
						data-turbo-frame="_top" 
						class="button__action">
						{{"Ajouter une morphology"|capitalize}}
					</a>
			</div>
		</template>

	</turbo-stream>
	<turbo-stream action="remove" targets="#color-form-modal"></turbo-stream>
{% endblock %}
