{% set shipping = order.shippinfo %}
{% set customerName = ((shipping.firstName|default('') ~ ' ' ~ shipping.lastName|default(''))|trim) %}

<div class="modal-backdrop">
    <dialog class="modal delivery-confirmation-modal" open aria-labelledby="delivery-confirmation-title">
        <form method="post" action="{{ path('app_orders_deliveries_mark_delivered', {id: order.id}) }}" data-turbo="false">
            <header class="modal__header">
                <div>
                    <h2 id="delivery-confirmation-title">Confirmer la livraison</h2>
                    <p class="modal__subtitle">Commande {{ order.orderReference }}</p>
                </div>
                <button type="button" class="modal__close" onclick="this.closest('.modal-backdrop').remove()" aria-label="Fermer">
                    &times;
                </button>
            </header>

            <div class="modal__body">
                <dl class="delivery-confirmation-modal__customer">
                    <div>
                        <dt>Client</dt>
                        <dd>{{ customerName ?: 'Non renseigné' }}</dd>
                    </div>
                    <div>
                        <dt>Téléphone</dt>
                        <dd>{{ shipping.phone|default('Non renseigné') }}</dd>
                    </div>
                </dl>

                <p>Confirmez-vous que cette commande a bien été livrée au client ?</p>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('mark_order_delivered_' ~ order.id) }}">
            </div>

            <footer class="modal__actions">
                <button type="button" class="orders-table-action" onclick="this.closest('.modal-backdrop').remove()">
                    Annuler
                </button>
                <button type="submit" class="orders-table-action orders-table-action--primary">
                    Oui, la commande est livrée
                </button>
            </footer>
        </form>
    </dialog>
</div>
