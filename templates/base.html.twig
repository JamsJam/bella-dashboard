<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <meta name="turbo-prefetch" content="true">
    <meta name="view-transition" content="same-origin" />
    <title>{% block title %} | Bellagp Dashboard{% endblock %}</title>
    {# ? === languages === #}
    <link rel="alternate" hreflang="fr" href="https://dashboard.bellagp.fr/">

    {# ? === favicon === #}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    {# ? === css global === #}
    {% block stylesheets %}
        {# <link rel="stylesheet" href="{{ asset('styles/admin.scss') }}"> #}
    {% endblock %}
    {# ? === js === #}
    {% block javascripts %}
        {% block importmap %}{{ importmap(['admin']) }}{% endblock %}
    {% endblock %}
</head>
<body class="admin" {{stimulus_controller('menu_reload')}} data-turbo-prefetch="true">

    {#?===== twig component adminmenu #}
    {# <turbo-frame 
        data-turbo-preload="true"
        id="admin_menu" 
        {{stimulus_target('menu_reload', 'menu')}} >

        <twig:Dashboard:Menu:Menu 
            routeKey="{{ metaData.routeKey }}"
        />
    </turbo-frame>


    <turbo-frame 
        id="admin-main"  
        data-turbo-preload="true"
        {{stimulus_target('menu_reload', 'main')}}
        >
        <main style="view-transition-name:admin_main">
            {% block body %}
                
            {% endblock %}
        </main>
    </turbo-frame> #}
    
</body>
</html>
