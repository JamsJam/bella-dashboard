{% extends 'base.html.twig' %}

{% block title %}Commande {{ order.orderReference }}{% endblock %}

{% block body %}
    <article class="admin-page order-show" aria-labelledby="order-title">
        <header class="order-show__header">
            <div>
                <a class="order-show__back" href="{{ path('app_orders') }}">← Retour aux commandes</a>
                <p class="orders-header__eyebrow">Détail de la commande</p>
                <h1 id="order-title">{{ order.orderReference }}</h1>
                <p>Créée le {{ order.createdAt|date('d/m/Y à H:i') }}</p>
            </div>
            <div class="order-show__header-status">
                {% include 'orders/_status_badge.html.twig' with {order: order} only %}
                {% include 'orders/_payment_badge.html.twig' with {order: order} only %}
            </div>
        </header>

        <div class="order-show__layout">
            <main class="order-show__main">
                <section class="order-panel">
                    <header><h2>Articles</h2><span>{{ order.cart.items|length }} ligne{{ order.cart.items|length > 1 ? 's' : '' }}</span></header>
                    <div class="order-items">
                        {% for item in order.cart.items %}
                            <article class="order-item">
                                <div>
                                    <strong>{{ item.name }}</strong>
                                    <small>Quantité {{ item.quantity }} · {{ (item.unitPriceTTC / 100)|number_format(2, ',', ' ') }} € l’unité</small>
                                </div>
                                <strong>{{ (item.totalTTC / 100)|number_format(2, ',', ' ') }} €</strong>
                            </article>
                        {% endfor %}
                    </div>
                    <dl class="order-totals">
                        <div><dt>Sous-total</dt><dd>{{ (order.subtotal / 100)|number_format(2, ',', ' ') }} €</dd></div>
                        <div><dt>Livraison</dt><dd>{{ (order.fees / 100)|number_format(2, ',', ' ') }} €</dd></div>
                        <div><dt>TVA incluse</dt><dd>{{ (order.tva / 100)|number_format(2, ',', ' ') }} €</dd></div>
                        <div class="order-totals__total"><dt>Total</dt><dd>{{ (order.total / 100)|number_format(2, ',', ' ') }} €</dd></div>
                    </dl>
                </section>
            </main>

            <aside class="order-show__aside">
                <section class="order-panel order-panel--reviews">
                    <header><h2>Avis</h2><span>{{ reviewSummary.total }} avis</span></header>
                    {% include 'orders/_reviews_cell.html.twig' with {order: order, reviewSummary: reviewSummary} only %}
                </section>

                <section class="order-panel">
                    <header><h2>Client</h2></header>
                    {% if order.customer %}
                        <a href="{{ path('app_customers_show', {id: order.customer.id}) }}">{{ order.customer.email }}</a>
                    {% else %}
                        <p>Client invité</p>
                    {% endif %}
                </section>

                <section class="order-panel">
                    <header><h2>Livraison</h2></header>
                    <address>
                        {{ order.shippinfo.address|default('Adresse non renseignée') }}<br>
                        {{ order.shippinfo.postcode|default('') }} {{ order.shippinfo.city|default('') }}<br>
                        {{ order.shippinfo.destination|default('') }}
                    </address>
                    {% include 'orders/_delivery_cell.html.twig' with {order: order, minimumDate: minimumDeliveryDate} only %}
                </section>

                <section class="order-panel">
                    <header><h2>Paiement</h2></header>
                    {% include 'orders/_payment_badge.html.twig' with {order: order} only %}
                    {% if order.stripeInvoiceUrl %}
                        <a class="order-show__action" href="{{ order.stripeInvoiceUrl }}" target="_blank" rel="noopener noreferrer">Ouvrir la facture</a>
                    {% endif %}
                </section>
            </aside>
        </div>

        <div id="modal-root"></div>
    </article>
{% endblock %}
