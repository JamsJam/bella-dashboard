<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Votre commande a été livrée</title>
</head>
<body style="margin:0;background:#f4f6f8;color:#20242a;font-family:Arial,Helvetica,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Votre commande {{ order.orderReference }} a été livrée. Partagez votre expérience avec BellaGP.</div>
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background:#f4f6f8;padding:32px 12px;">
    <tr><td align="center">
        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:640px;background:#ffffff;border:1px solid #e4e7eb;border-radius:16px;overflow:hidden;box-shadow:0 8px 24px rgba(32,36,42,.08);">
            <tr><td style="padding:23px 32px 28px;border-top:5px solid #b06a46;border-bottom:1px solid #e4e7eb;">
                <div style="font-size:24px;font-weight:800;letter-spacing:-.5px;color:#20242a;">BellaGP</div>
                <div style="margin-top:6px;font-size:13px;color:#737b86;">Commande {{ order.orderReference }}</div>
            </td></tr>
            <tr><td style="padding:32px;">
                <div style="display:inline-block;margin-bottom:12px;padding:6px 10px;border-radius:999px;background:#fbf0e9;color:#9a5533;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.04em;">Livraison terminée</div>
                <h1 style="margin:0 0 12px;font-size:26px;line-height:1.25;">Que pensez-vous de vos articles ?</h1>
                <p style="margin:0 0 22px;color:#626b76;font-size:15px;line-height:1.65;">
                    Votre commande a bien été livrée. En quelques instants, partagez votre expérience pour aider les prochains clients à faire leur choix.
                </p>
                {% if reviews is not empty %}
                    <div style="padding:20px;border:1px solid #eadfd8;border-radius:10px;background:#fdf9f6;color:#626b76;font-size:14px;line-height:1.6;">
                        <strong style="display:block;color:#20242a;font-size:16px;">Donnez votre avis</strong>
                        <span style="display:block;margin-top:4px;">Choisissez un article pour commencer.</span>
                        {% for review in reviews %}
                            <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin-top:16px;border-top:1px solid #eadfd8;">
                                <tr>
                                    <td style="padding-top:16px;color:#20242a;font-size:14px;">{{ review.product.name }}</td>
                                    <td align="right" style="padding-top:16px;padding-left:12px;">
                                        <a href="{{ (front_app_url|default(''))|trim('/') }}/avis/{{ review.reviewUuid }}" style="display:inline-block;padding:11px 16px;border-radius:8px;background:#b06a46;color:#ffffff;text-decoration:none;font-size:13px;font-weight:700;white-space:nowrap;">Évaluer cet article</a>
                                    </td>
                                </tr>
                            </table>
                        {% endfor %}
                    </div>
                    <p style="margin:20px 0 0;color:#737b86;font-size:12px;line-height:1.6;">Chaque lien est personnel et correspond à l’article indiqué.</p>
                {% else %}
                    <p style="margin:0;color:#626b76;font-size:14px;line-height:1.6;">Merci d’avoir choisi BellaGP. Nous espérons vous retrouver bientôt.</p>
                {% endif %}
            </td></tr>
            <tr><td style="padding:20px 32px;background:#f9fafb;border-top:1px solid #e4e7eb;color:#8a929d;font-size:12px;text-align:center;">BellaGP · Votre satisfaction est notre priorité.</td></tr>
        </table>
    </td></tr>
</table>
</body>
</html>
